{
  "$description": "Component tokens — reference semantic (theme-following) or primitive (theme-fixed) tokens only.",
  "color": {
    "$type": "color",
    "quizOption": {
      "idle": {
        "bg": { "$value": "{color.surface.default}" },
        "border": { "$value": "{color.border.subtle}" },
        "fg": { "$value": "{color.text.primary}" }
      },
      "selected": {
        "bg": { "$value": "{color.surface.selected}" },
        "border": { "$value": "{color.focus.ring}" },
        "fg": { "$value": "{color.text.primary}" }
      },
      "correct": {
        "$description": "Always paired with a ✓ icon — never colour alone",
        "bg": { "$value": "{color.feedback.successSubtle}" },
        "border": { "$value": "{color.feedback.successText}" },
        "fg": { "$value": "{color.text.primary}" }
      },
      "wrong": {
        "$description": "Always paired with a ✕ icon — never colour alone",
        "bg": { "$value": "{color.feedback.errorSubtle}" },
        "border": { "$value": "{color.feedback.error}" },
        "fg": { "$value": "{color.text.primary}" }
      },
      "revealed": {
        "$description": "The correct answer shown after a wrong pick — dashed border",
        "bg": { "$value": "{color.surface.default}" },
        "border": { "$value": "{color.feedback.successText}" },
        "fg": { "$value": "{color.text.primary}" }
      }
    },
    "timer": {
      "$description": "Calm until it matters (C2): neutral → butter → red",
      "safe": { "$value": "{color.surface.sunken}" },
      "warn": { "$value": "{color.butter.300}" },
      "critical": { "$value": "{color.red.600}" },
      "fg": { "$value": "{color.ink.900}" },
      "criticalFg": { "$value": "{color.white}" }
    },
    "tier": {
      "wanderer": {
        "bg": { "$value": "{color.surface.default}" },
        "seal": { "$value": "{color.ink.900}" }
      },
      "achiever": {
        "$description": "Pro — violet band + butter seal + orange cap (C6)",
        "bg": { "$value": "{color.violet.700}" },
        "fg": { "$value": "{color.white}" },
        "seal": { "$value": "{color.butter.300}" },
        "cap": { "$value": "{color.orange.500}" }
      }
    },
    "flashcard": {
      "$description": "Flashcard and note tones (SKILL.md §5). A card may take any tone; its subtopic wash (the pattern that subtopic added) is inked tone-on-tone: the tone mixed 42% toward ink, the same rule as patchwork pattern ink. The plain tone uses surface.default and the subtopic's own washInk from the manifest. Theme-fixed like the category tints: ink text in both themes.",
      "fg": { "$value": "{color.ink.900}" },
      "sage": { "bg": { "$value": "{color.sage.300}" }, "wash": { "$value": "#6B8578", "$description": "Wash ink; layer opacity .30" } },
      "sky": { "bg": { "$value": "{color.sky.300}" }, "wash": { "$value": "#7A87A0", "$description": "Wash ink; layer opacity .30" } },
      "coral": { "bg": { "$value": "{color.coral.300}" }, "wash": { "$value": "#9F5F52", "$description": "Wash ink; layer opacity .30" } },
      "butter": { "bg": { "$value": "{color.butter.300}" }, "wash": { "$value": "#A08751", "$description": "Wash ink; layer opacity .30" } },
      "violet": { "bg": { "$value": "{color.violet.100}" }, "wash": { "$value": "#938BA0", "$description": "Wash ink; layer opacity .30" } },
      "blush": { "bg": { "$value": "{color.blush.300}" }, "wash": { "$value": "#9B7484", "$description": "Wash ink; layer opacity .30" } }
    },
    "banner": {
      "$description": "Feature banners (SKILL.md §8): violet stadium, orange disc, hairline arcs. Each context pairs two of the 16 patterns (band · disc) that dissolve toward the copy: cta halftone·chevron, achiever diamonds·arcs, promo plus·waves, streak dashes·scales. Patterns only, never pack icons. Theme-fixed.",
      "bg": { "$value": "{color.violet.700}" },
      "fg": { "$value": "{color.white}" },
      "bandInk": { "$value": "{color.violet.400}", "$description": "Band pattern, tone on tone" },
      "disc": { "$value": "{color.orange.500}" },
      "discInk": { "$value": "{color.orange.300}", "$description": "Disc pattern, tone on tone" },
      "arc": { "$value": "{color.violet.300}", "$description": "Hairline circle outlines" }
    },
    "reward": {
      "points": { "$value": "{color.butter.500}", "$description": "Coin glyph" },
      "pointsFill": { "$value": "{color.butter.300}" },
      "streak": { "$value": "{color.orange.500}", "$description": "Flame glyph" },
      "streakDone": { "$value": "{color.orange.500}" },
      "streakToday": { "$value": "{color.butter.300}" }
    },
    "grade": {
      "$description": "fg = text on the grade fill. Letter always shown.",
      "a": { "bg": { "$value": "{color.sage.300}" }, "fg": { "$value": "{color.ink.900}" } },
      "b": { "bg": { "$value": "{color.sage.100}" }, "fg": { "$value": "{color.ink.900}" } },
      "c": { "bg": { "$value": "{color.butter.300}" }, "fg": { "$value": "{color.ink.900}" } },
      "d": { "bg": { "$value": "{color.orange.300}" }, "fg": { "$value": "{color.ink.900}" } },
      "e": { "bg": { "$value": "{color.coral.300}" }, "fg": { "$value": "{color.ink.900}" } },
      "f": { "bg": { "$value": "{color.red.600}" }, "fg": { "$value": "{color.white}" } }
    },
    "category": {
      "$description": "Category tints for chips and the in-app patchwork FALLBACK (tint + Phosphor duotone) when a node has no generated patchwork. Real patchworks are generated per node (SKILL.md §12). Ink text + ink outline.",
      "1": { "$value": "{color.sage.300}" },
      "2": { "$value": "{color.sky.300}" },
      "3": { "$value": "{color.coral.300}" },
      "4": { "$value": "{color.butter.300}" },
      "5": { "$value": "{color.violet.100}" },
      "6": { "$value": "{color.blush.300}" },
      "fg": { "$value": "{color.ink.900}" },
      "outline": { "$value": "{color.ink.900}" }
    },
    "patchwork": {
      "$description": "Hierarchy patchworks (D16, SKILL.md §12). Theme-fixed: tiles keep light plates in dark mode. Patch tints come from the subject families in scripts/patchwork/engine.py; pattern ink is the patch tint mixed 42% toward ink.",
      "seam": { "$value": "{color.ink.900}", "$description": "Frame and patch seams" },
      "plate": { "$value": "{color.white}", "$description": "Icon plate behind the node icon" },
      "iconLine": { "$value": "{color.ink.900}", "$description": "Icon outline" },
      "iconShade": { "$value": "{color.canvas.200}", "$description": "Icon shade layers" }
    },
    "chart": {
      "1": { "$value": "{color.violet.500}" },
      "2": { "$value": "{color.orange.500}" },
      "3": { "$value": "{color.sage.500}" },
      "4": { "$value": "{color.butter.500}" },
      "5": { "$value": "{color.sky.500}" }
    }
  },
  "size": {
    "$type": "dimension",
    "button": {
      "sm": { "$value": "36px" },
      "md": { "$value": "48px" },
      "lg": { "$value": "56px" }
    },
    "quizOption": {
      "minHeight": { "$value": "56px" }
    },
    "iconButton": {
      "hit": { "$value": "{touch.minTarget}" },
      "visual": { "$value": "40px" }
    }
  }
}
