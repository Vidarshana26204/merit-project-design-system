{
  "$description": "Merit v3 primitives — raw values. Screens must NOT reference these directly; use semantic or component tokens.",
  "color": {
    "$type": "color",
    "white": { "$value": "#FFFFFF" },
    "canvas": {
      "50": { "$value": "#FBFAF4", "$description": "bg.app — warm off-white (D10)" },
      "100": { "$value": "#F4F1E6", "$description": "Sunken wells, tracks" },
      "200": { "$value": "#E9E4D4", "$description": "Light hairline / divider" }
    },
    "ink": {
      "500": { "$value": "#68667F", "$description": "Tertiary text, input borders" },
      "700": { "$value": "#4A4760", "$description": "Secondary text" },
      "900": { "$value": "#1E1B2E", "$description": "Primary text, outlines, labels on orange (D9)" }
    },
    "orange": {
      "100": { "$value": "#FFE7D8" },
      "300": { "$value": "#FF9A63" },
      "400": { "$value": "#FF8A4C", "$description": "Dark-mode action / eyebrow" },
      "500": { "$value": "#F65E16", "$description": "Brand orange — fills with INK labels only (D9)" },
      "600": { "$value": "#EA540E", "$description": "Pressed — darkest orange that still carries an ink label (4.61:1)" },
      "700": { "$value": "#B23F06", "$description": "Strong fill with white label · eyebrow text on light" }
    },
    "coral": {
      "100": { "$value": "#FEE3D8" },
      "300": { "$value": "#FC906C", "$description": "Patch / energy tint" }
    },
    "sand": {
      "100": { "$value": "#FCEBD3", "$description": "Brand / landing bands" },
      "300": { "$value": "#F0DEC0", "$description": "Patch tint" }
    },
    "violet": {
      "50": { "$value": "#F4EFF9" },
      "100": { "$value": "#E7DCF2", "$description": "Selected tint" },
      "300": { "$value": "#C9B3EA", "$description": "Dark-mode link / focus / accent" },
      "400": { "$value": "#905AA8", "$description": "Lilac patch" },
      "500": { "$value": "#663696", "$description": "Link, focus ring, calm-mode selection" },
      "600": { "$value": "#7E24DE", "$description": "Electric — sparkles only" },
      "700": { "$value": "#54306C", "$description": "Brand violet — feature bands, accent fill, Achiever" },
      "800": { "$value": "#3C244E", "$description": "Pressed · dark-mode feature band" },
      "900": { "$value": "#24162F" }
    },
    "sage": {
      "100": { "$value": "#E2F2E6", "$description": "Correct-answer fill (light)" },
      "300": { "$value": "#A2D2AE", "$description": "Success fill" },
      "500": { "$value": "#6FAF82" },
      "700": { "$value": "#2F6B43", "$description": "Success text on light" },
      "900": { "$value": "#1D3B28", "$description": "Correct-answer fill (dark)" }
    },
    "butter": {
      "100": { "$value": "#FFF3CC" },
      "300": { "$value": "#FFD66B", "$description": "Reward fill, warning, Achiever seal" },
      "500": { "$value": "#F5B700", "$description": "Coin glyph" }
    },
    "blush": { "300": { "$value": "#F6B5C3", "$description": "Category only" } },
    "sky": {
      "300": { "$value": "#BCD6F2", "$description": "Category only" },
      "500": { "$value": "#5B8FCB", "$description": "Chart only" }
    },
    "red": {
      "100": { "$value": "#FBDAD6", "$description": "Wrong-answer fill (light)" },
      "300": { "$value": "#FF9A8F", "$description": "Dark-mode error" },
      "600": { "$value": "#C7362F", "$description": "Error (light)" },
      "900": { "$value": "#5A1A1A", "$description": "Wrong-answer fill (dark)" }
    },
    "night": {
      "600": { "$value": "#3A3048", "$description": "Dark hairline" },
      "700": { "$value": "#2E2539" },
      "800": { "$value": "#221B2C", "$description": "Dark surface" },
      "850": { "$value": "#1C1625", "$description": "Dark sunken" },
      "900": { "$value": "#17121F", "$description": "Dark background — violet-black (D15)" }
    },
    "mist": {
      "50": { "$value": "#F7F3EA", "$description": "Dark-mode primary text" },
      "300": { "$value": "#B9B2C6", "$description": "Dark secondary text" },
      "400": { "$value": "#9C94AC", "$description": "Dark tertiary text, input borders" }
    }
  },
  "space": {
    "$type": "dimension",
    "0": { "$value": "0px" },
    "1": { "$value": "4px" },
    "2": { "$value": "8px" },
    "3": { "$value": "12px" },
    "4": { "$value": "16px" },
    "5": { "$value": "20px" },
    "6": { "$value": "24px" },
    "8": { "$value": "32px" },
    "10": { "$value": "40px" },
    "12": { "$value": "48px" },
    "16": { "$value": "64px" }
  },
  "radius": {
    "$type": "dimension",
    "xs": { "$value": "6px", "$description": "Tiny chips" },
    "sm": { "$value": "10px", "$description": "Icon chips, letter chips" },
    "md": { "$value": "16px", "$description": "Inputs, quiz options" },
    "lg": { "$value": "20px", "$description": "Small cards, patchwork tiles" },
    "xl": { "$value": "24px", "$description": "Cards (D11)" },
    "2xl": { "$value": "32px", "$description": "Sheets, feature bands" },
    "pill": { "$value": "999px" }
  },
  "borderWidth": {
    "$type": "dimension",
    "$description": "v3: cards have no border (D11). Outlines are for inputs, chips and illustration.",
    "hairline": { "$value": "1px", "$description": "Dividers, compact table cells" },
    "base": { "$value": "1.5px", "$description": "Inputs, filter chips, patchwork outlines" },
    "strong": { "$value": "2px", "$description": "Selected / focused component edge" }
  },
  "duration": {
    "$type": "duration",
    "instant": { "$value": "80ms" },
    "fast": { "$value": "120ms", "$description": "Press" },
    "base": { "$value": "180ms", "$description": "Toggle, tab" },
    "slow": { "$value": "280ms", "$description": "Sheet, card-flip half" },
    "celebrate": { "$value": "600ms", "$description": "Grade, level-up" }
  },
  "easing": {
    "$type": "cubicBezier",
    "standard": { "$value": [0.2, 0.7, 0.2, 1] },
    "exit": { "$value": [0.4, 0, 1, 1] }
  },
  "opacity": {
    "$type": "number",
    "disabled": { "$value": 0.4 },
    "scrimLight": { "$value": 0.5 },
    "scrimDark": { "$value": 0.7 },
    "subjectTintLight": { "$value": 0.3, "$description": "Share of a subject's color_hex in its hub header tint (light), mixed into subject.headerBase" },
    "subjectTintDark": { "$value": 0.24, "$description": "Share of a subject's color_hex in its hub header tint (dark)" },
    "subjectRimDark": { "$value": 0.4, "$description": "Dark only: subject colour at this alpha as a 1.5 bottom rim on hub headers" }
  },
  "zIndex": {
    "$type": "number",
    "$extensions": { "merit.platforms": ["css"] },
    "base": { "$value": 0 },
    "sticky": { "$value": 10 },
    "dropdown": { "$value": 20 },
    "overlay": { "$value": 30 },
    "modal": { "$value": 40 },
    "toast": { "$value": 50 }
  },
  "breakpoint": {
    "$type": "dimension",
    "$extensions": { "merit.platforms": ["css"] },
    "sm": { "$value": "640px" },
    "md": { "$value": "768px" },
    "lg": { "$value": "1024px" },
    "xl": { "$value": "1280px" }
  },
  "touch": {
    "$type": "dimension",
    "minTarget": { "$value": "48px", "$description": "48dp Android / ≥44pt iOS" }
  },
  "fontFamily": {
    "$type": "fontFamily",
    "$description": "Latin faces have no Sinhala/Tamil glyphs — every stack falls back to Noto Sans Sinhala / Tamil before system fonts.",
    "$extensions": { "merit.flutterFallback": ["NotoSansSinhala", "NotoSansTamil"] },
    "display": {
      "$value": ["General Sans", "Plus Jakarta Sans", "Noto Sans Sinhala", "Noto Sans Tamil", "system-ui", "sans-serif"],
      "$description": "Headings, numbers, wordmark (D8). Product + landing — School Times retired (D13)",
      "$extensions": { "merit.flutter": "GeneralSans" }
    },
    "body": {
      "$value": ["Plus Jakarta Sans", "Noto Sans Sinhala", "Noto Sans Tamil", "system-ui", "sans-serif"],
      "$extensions": { "merit.flutter": "PlusJakartaSans" }
    }
  },
  "fontWeight": {
    "$type": "fontWeight",
    "regular": { "$value": 400 },
    "medium": { "$value": 500 },
    "semibold": { "$value": 600 },
    "bold": { "$value": 700, "$description": "Heaviest shipped cut — never 800" }
  }
}
